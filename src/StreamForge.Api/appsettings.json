{
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-host;Database=streamforge;Username=postgres;Password=your-password"
  },
  "Jwt": {
    "Issuer": "StreamForge",
    "Audience": "StreamForge.Api",
    "SigningKey": "replace-this-with-a-long-random-development-secret-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiter": {
    "PermitLimit": 100,
    "WindowMinutes": 1,
    "SegmentsPerWindow": 8,
    "UploadPermitLimit": 1000,
    "UploadWindowMinutes": 1,
    "UploadSegmentsPerWindow": 8
  },
  "Upload": {
    "StoragePath": "./uploads",
    "MaxFileSize": 5368709120,
    "ChunkSize": 5242880,
    "AllowedMimeTypes": [
    "video/mp4",
    "video/webm",
    "video/quicktime",
    "video/x-msvideo",
    "video/x-matroska",
    "video/matroska",
    "video/matroska-3d",
    "video/mpeg"
  ],
    "SessionExpirationMinutes": 1440,
    "StorageProviderType": "local"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
