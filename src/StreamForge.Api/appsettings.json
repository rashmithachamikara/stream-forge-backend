{
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-host;Database=streamforge;Username=postgres;Password=your-password"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": true,
    "WarnOnPendingMigrations": true
  },
  "Jwt": {
    "Issuer": "StreamForge",
    "Audience": "StreamForge.Api",
    "SigningKey": "replace-this-with-a-long-random-development-secret-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiter": {
    "PermitLimit": 100,
    "WindowMinutes": 1,
    "SegmentsPerWindow": 8,
    "UploadPermitLimit": 1000,
    "UploadWindowMinutes": 1,
    "UploadSegmentsPerWindow": 8,
    "PlaybackPermitLimit": 5000,
    "PlaybackWindowMinutes": 1,
    "PlaybackSegmentsPerWindow": 8
  },
  "Upload": {
    "StoragePath": "./uploads",
    "MaxFileSize": 5368709120,
    "ChunkSize": 5242880,
    "AllowedMimeTypes": [
    "video/mp4",
    "video/webm",
    "video/quicktime",
    "video/x-msvideo",
    "video/x-matroska",
    "video/matroska",
    "video/matroska-3d",
    "video/mpeg"
  ],
    "SessionExpirationMinutes": 1440,
    "StorageProviderType": "local"
  },
  "VideoProcessing": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "HlsSegmentSeconds": 6,
    "ThumbnailTimestampPercent": 10
  },
  "Analytics": {
    "Enabled": true,
    "IngestionEnabled": true,
    "ReportingEnabled": true,
    "AdminReportingEnabled": true,
    "CollectRawEvents": true,
    "CollectAnonymousEvents": true,
    "CollectUserAgent": true,
    "CollectIpAddress": true,
    "CollectPauseEvents": true,
    "CollectSeekEvents": true,
    "CollectCloseEvents": true,
    "EnableDeviceBreakdown": true,
    "EnableBrowserBreakdown": true,
    "EnableActiveViewerMetrics": true,
    "EnablePeakWatchTimeMetrics": true,
    "MinimumViewWatchSeconds": 30,
    "ActiveViewerWindowMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
