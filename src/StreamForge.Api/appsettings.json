{
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-host;Database=streamforge;Username=postgres;Password=your-password"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": true,
    "WarnOnPendingMigrations": true
  },
  "Jwt": {
    "Issuer": "StreamForge",
    "Audience": "StreamForge.Api",
    "SigningKey": "replace-this-with-a-long-random-development-secret-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiter": {
    "PermitLimit": 100,
    "WindowMinutes": 1,
    "SegmentsPerWindow": 8,
    "UploadPermitLimit": 1000,
    "UploadWindowMinutes": 1,
    "UploadSegmentsPerWindow": 8,
    "PlaybackPermitLimit": 5000,
    "PlaybackWindowMinutes": 1,
    "PlaybackSegmentsPerWindow": 8
  },
  "Storage": {
    "ProviderType": "local",
    "Local": {
      "RootPath": "",
      "UploadsRelativePath": "uploads",
      "TranscriptionOutputRelativePath": "transcription-output"
    },
    "S3": {
    }
  },
  "Upload": {
    "MaxFileSize": 5368709120,
    "ChunkSize": 5242880,
    "AllowedMimeTypes": [
    "video/mp4",
    "video/webm",
    "video/quicktime",
    "video/x-msvideo",
    "video/x-matroska",
    "video/matroska",
    "video/matroska-3d",
    "video/mpeg"
    ],
    "SessionExpirationMinutes": 1440
  },
  "VideoProcessing": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "HlsSegmentSeconds": 6,
    "ThumbnailTimestampPercent": 10
  },
  "Transcription": {
    "Enabled": false,
    "AutoTranscribeOnReady": false,
    "Provider": "local-faster-whisper",
    "DefaultLanguage": "",
    "OutputFormats": [ "vtt", "srt" ],
    "WorkerBaseUrl": "http://127.0.0.1:8090",
    "CallbackBaseUrl": "http://127.0.0.1:5186",
    "WorkerCallbackSecret": "",
    "WorkerCallbackAuthHeader": "X-StreamForge-Worker-Secret",
    "JobTimeoutMinutes": 120,
    "LocalFasterWhisper": {
      "Model": "small",
      "Device": "cpu",
      "ComputeType": "int8",
      "BeamSize": 5,
      "EnableVad": true,
      "EnableWordTimestamps": false
    }
  },
  "Rag": {
    "Enabled": false,
    "SemanticSearchEnabled": false,
    "VideoQuestionsEnabled": false,
    "CrossVideoQuestionsEnabled": false,
    "WorkerBaseUrl": "http://127.0.0.1:8091",
    "JobTimeoutMinutes": 30,
    "EmbeddingProvider": "local-sentence-transformer",
    "EmbeddingModel": "sentence-transformers/all-MiniLM-L6-v2",
    "EmbeddingBatchSize": 100,
    "RetrievalDefaultMode": "hybrid",
    "SemanticTopK": 8,
    "FullTextTopK": 8,
    "QaProvider": "disabled",
    "QaModel": "",
    "QaMaxContextChunks": 8,
    "QaMaxCitations": 5
  },
  "Analytics": {
    "Enabled": true,
    "IngestionEnabled": true,
    "ReportingEnabled": true,
    "AdminReportingEnabled": true,
    "CollectRawEvents": true,
    "CollectAnonymousEvents": true,
    "CollectUserAgent": true,
    "CollectIpAddress": true,
    "CollectPauseEvents": true,
    "CollectSeekEvents": true,
    "CollectCloseEvents": true,
    "EnableDeviceBreakdown": true,
    "EnableBrowserBreakdown": true,
    "EnableActiveViewerMetrics": true,
    "EnablePeakWatchTimeMetrics": true,
    "MinimumViewWatchSeconds": 30,
    "ActiveViewerWindowMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
