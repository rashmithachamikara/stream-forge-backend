POSTGRES_DB=streamforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

STREAMFORGE_API_PORT=8080
STREAMFORGE_FRONTEND_PORT=3000
STREAMFORGE_PUBLIC_API_URL=http://localhost:8080
STREAMFORGE_CORS_ORIGIN=http://localhost:3000
STREAMFORGE_DB_APPLY_MIGRATIONS_ON_STARTUP=false
STREAMFORGE_DB_SEED_ON_STARTUP=true
STREAMFORGE_DB_WARN_ON_PENDING_MIGRATIONS=true

STREAMFORGE_JWT_ISSUER=StreamForge
STREAMFORGE_JWT_AUDIENCE=StreamForge.Api
STREAMFORGE_JWT_SIGNING_KEY=replace-this-with-a-long-random-secret
STREAMFORGE_JWT_ACCESS_TOKEN_MINUTES=15
STREAMFORGE_JWT_REFRESH_TOKEN_DAYS=30

STREAMFORGE_RATE_LIMITER_PERMIT_LIMIT=1000
STREAMFORGE_RATE_LIMITER_WINDOW_MINUTES=1
STREAMFORGE_RATE_LIMITER_SEGMENTS_PER_WINDOW=8
STREAMFORGE_RATE_LIMITER_UPLOAD_PERMIT_LIMIT=5000
STREAMFORGE_RATE_LIMITER_UPLOAD_WINDOW_MINUTES=1
STREAMFORGE_RATE_LIMITER_UPLOAD_SEGMENTS_PER_WINDOW=8
STREAMFORGE_RATE_LIMITER_PLAYBACK_PERMIT_LIMIT=10000
STREAMFORGE_RATE_LIMITER_PLAYBACK_WINDOW_MINUTES=1
STREAMFORGE_RATE_LIMITER_PLAYBACK_SEGMENTS_PER_WINDOW=8

STREAMFORGE_TRANSCRIPTION_ENABLED=true
STREAMFORGE_TRANSCRIPTION_AUTO_ON_READY=true
STREAMFORGE_TRANSCRIPTION_WORKER_PORT=8090
STREAMFORGE_TRANSCRIPTION_CALLBACK_SECRET=
STREAMFORGE_TRANSCRIPTION_CALLBACK_HEADER=X-StreamForge-Worker-Secret
STREAMFORGE_TRANSCRIPTION_MODEL=small
STREAMFORGE_TRANSCRIPTION_DEVICE=cpu
STREAMFORGE_TRANSCRIPTION_COMPUTE_TYPE=int8
STREAMFORGE_TRANSCRIPTION_BEAM_SIZE=5
STREAMFORGE_TRANSCRIPTION_ENABLE_VAD=true
STREAMFORGE_TRANSCRIPTION_ENABLE_WORD_TIMESTAMPS=false

STREAMFORGE_RAG_ENABLED=true
STREAMFORGE_EMBEDDING_WORKER_PORT=8091
STREAMFORGE_RAG_SEMANTIC_SEARCH_ENABLED=true
STREAMFORGE_RAG_VIDEO_QUESTIONS_ENABLED=true
STREAMFORGE_RAG_CROSS_VIDEO_QUESTIONS_ENABLED=true
STREAMFORGE_RAG_EMBEDDING_PROVIDER=local-sentence-transformer
STREAMFORGE_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STREAMFORGE_RAG_EMBEDDING_DEVICE=cpu
STREAMFORGE_RAG_QA_PROVIDER=disabled
STREAMFORGE_DATA_PROTECTION_APP_NAME=StreamForge

STREAMFORGE_EF_CORE_LOG_LEVEL=Warning

# Optional. Used with compose.host-paths.yaml. Refer to README.md
STREAMFORGE_POSTGRES_HOST_PATH=./docker-data/postgres
STREAMFORGE_SHARED_DATA_HOST_PATH=./docker-data/shared-data
STREAMFORGE_DATA_PROTECTION_KEYS_HOST_PATH=./docker-data/data-protection-keys
STREAMFORGE_TRANSCRIPTION_MODEL_CACHE_HOST_PATH=./docker-data/transcription-models
STREAMFORGE_EMBEDDING_MODEL_CACHE_HOST_PATH=./docker-data/embedding-models
