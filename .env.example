POSTGRES_DB=streamforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

STREAMFORGE_API_PORT=8080
STREAMFORGE_CORS_ORIGIN=http://localhost:3000
STREAMFORGE_DB_APPLY_MIGRATIONS_ON_STARTUP=false
STREAMFORGE_DB_SEED_ON_STARTUP=true
STREAMFORGE_DB_WARN_ON_PENDING_MIGRATIONS=true

STREAMFORGE_JWT_ISSUER=StreamForge
STREAMFORGE_JWT_AUDIENCE=StreamForge.Api
STREAMFORGE_JWT_SIGNING_KEY=replace-this-with-a-long-random-secret
STREAMFORGE_JWT_ACCESS_TOKEN_MINUTES=15
STREAMFORGE_JWT_REFRESH_TOKEN_DAYS=30

# Optional. Used with compose.host-paths.yaml. Refer to README.md
STREAMFORGE_POSTGRES_HOST_PATH=./docker-data/postgres
STREAMFORGE_MEDIA_HOST_PATH=./docker-data/uploads